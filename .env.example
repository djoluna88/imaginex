# Copy to .env and fill in. Never commit .env.
#
# Only `make deploy` and `make run` need these two values: they point the Databricks CLI at the
# workspace where the job runs. Tests and the snapshot simulator work with the file left empty.
#
# No quotes, no spaces around "=", no trailing slash on the host. If you edit this on Windows,
# keep LF line endings: a CRLF leaves an invisible \r at the end of the token and the CLI
# answers "invalid token".
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
