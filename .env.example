# Used by src/nba_pipeline/source.py to upload the Kaggle CSV into the volume.
# Copy to .env and fill in. Never commit .env.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# Kaggle credentials for kagglehub (or place kaggle.json under ~/.kaggle/)
KAGGLE_USERNAME=
KAGGLE_KEY=
